# 로컬 기본값 (docker compose postgres 기준)
DATABASE_URL=postgresql+psycopg://foodtech:foodtech@localhost:5432/foodtech

# GitHub Actions 크론이 /jobs/* 호출 시 사용하는 Bearer 토큰
JOBS_TOKEN=change-me

# 회원 API(/api/members) 잠금용 Bearer 토큰 — 매직링크 로그인 도입 전까지 (openssl rand -hex 32)
ADMIN_TOKEN=change-me

# 뉴스 수집 (T-001) — 키가 없으면 해당 소스는 건너뛰고 RSS 폴백으로 동작
NAVER_CLIENT_ID=          # 네이버 개발자센터 앱 (국내 뉴스 1차)
NAVER_CLIENT_SECRET=
BRAVE_SEARCH_API_KEY=     # Brave Search API (해외 뉴스 1차, 월 $5 크레딧 종량제)
# NEWS_CACHE_PATH=data/news_cache.json   # 캐시 파일 위치 (기본값 사용 권장)
# NEWS_MAX_AGE_HOURS=36                  # 헬스체크 신선도 기준
# NEWS_MIN_ITEMS=5                       # 헬스체크 최소 건수 기준

# LLM — OpenRouter 게이트웨이 (결정 7). 키 한도 $25 설정됨. 뉴스 분류(T-006)도 이 키 사용
OPENROUTER_API_KEY=
# NEWS_CLASSIFY_MODEL=google/gemini-2.5-flash   # 분류 모델 (기본값 사용 권장, T-004 확정)

# 추적 (T-003) — Resend 대시보드 > Webhooks에서 웹훅 생성 시 발급되는 서명 시크릿 (whsec_...)
RESEND_WEBHOOK_SECRET=

# 이후 기능 티켓에서 추가 예정:
# RESEND_API_KEY=       (뉴스레터 발송 — 실키는 .env에만!)
# NEWSDATA_API_KEY=     (해외 보조 API — 검토 중)
