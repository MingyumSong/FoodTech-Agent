# 로컬 기본값 (docker compose postgres 기준)
DATABASE_URL=postgresql+psycopg://foodtech:foodtech@localhost:5432/foodtech

# GitHub Actions 크론이 /jobs/* 호출 시 사용하는 Bearer 토큰
JOBS_TOKEN=change-me

# 관리자 화면·대시보드 잠금용 (openssl rand -hex 32). 매직링크 로그인 도입 전까지.
# **비워두고 APP_ENV=local 이면 개발 모드**로 뜬다 — 인증 없이 화면을 볼 수 있고 배너가 뜬다.
# 화면만 만지는 사람은 이 파일 없이 `bash scripts/dev.sh` 만 돌려도 된다.
ADMIN_TOKEN=change-me

# 기계용 — 참여도 CSV **조회만** 되는 별도 토큰 (openssl rand -hex 32).
# 대시보드 연동(Cloudflare Pages의 NEWSLETTER_ADMIN_TOKEN)이 이 값을 쓴다.
# 이걸로는 회원 명단·발송 실행이 열리지 않고, CSV에서 이메일 열도 빠진다.
# 비워두면 그 경로 자체가 비활성 — 관리자 비번으로만 CSV를 받을 수 있다.
SCORES_TOKEN=

# local | dev | test → 개발 모드 가능. 그 외(운영은 prod)는 항상 인증을 요구한다.
# 운영은 scripts/railway-env-sync.sh 가 APP_ENV=prod 를 넣는다 — 바꾸지 말 것.
APP_ENV=local

# 뉴스 수집 (T-001) — 키가 없으면 해당 소스는 건너뛰고 RSS 폴백으로 동작
NAVER_CLIENT_ID=          # 네이버 개발자센터 앱 (국내 뉴스 1차)
NAVER_CLIENT_SECRET=
BRAVE_SEARCH_API_KEY=     # Brave Search API (해외 뉴스 1차, 월 $5 크레딧 종량제)
# NEWS_CACHE_PATH=data/news_cache.json   # 캐시 파일 위치 (기본값 사용 권장)
# NEWS_MAX_AGE_HOURS=36                  # 헬스체크 신선도 기준
# NEWS_MIN_ITEMS=5                       # 헬스체크 최소 건수 기준

# LLM — OpenRouter 게이트웨이 (결정 7). 키 한도 $25 설정됨. 뉴스 분류(T-006)도 이 키 사용
OPENROUTER_API_KEY=
# NEWS_CLASSIFY_MODEL=google/gemini-2.5-flash   # 분류 모델 (기본값 사용 권장, T-004 확정)

# 추적 (T-003) — Resend 대시보드 > Webhooks에서 웹훅 생성 시 발급되는 서명 시크릿 (whsec_...)
RESEND_WEBHOOK_SECRET=

# 발송 (T-008) — Resend API 키. 비워두면 DRY RUN (실발송 없이 조립·send_logs만)
RESEND_API_KEY=
# 답장 수신 주소 (T-013) — 발신 도메인(news.foodtech-center.org)엔 MX가 없어서
# 이 값이 없으면 수신자의 답장이 반송된다. 운영값은 교수님 지메일.
NEWSLETTER_REPLY_TO=
# 이메일 속 수신거부 링크의 베이스 URL (운영: https://app-production-945c.up.railway.app)
PUBLIC_BASE_URL=http://localhost:8000

# 이후 기능 티켓에서 추가 예정:
# NEWSDATA_API_KEY=     (해외 보조 API — 검토 중)
